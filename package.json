{
  "name": "adapt_authoring",
  "version": "0.10.5",
  "license": "GPL-3.0",
  "description": "A server-based user interface for authoring eLearning courses using the Adapt Framework.",
  "keywords": [
    "adapt",
    "authoring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adaptlearning/adapt_authoring.git"
  },
  "main": "index",
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "test": "grunt test && node test/output/reportserver || node test/output/reportserver",
    "migrate": "migrate --config conf/migrate.json --template-file migrations/helpers/template.js",
    "server": "%node12% server",
    "build:prod": "grunt build:prod",
    "build": "grunt build",
    "build:dev": "grunt build:dev",
    "build:translate": "grunt build:translate"
  },
  "overrides": {
    "connect-mongodb-session": {
      "mongodb": "$mongodb"
    }
  },
  "dependencies": {
